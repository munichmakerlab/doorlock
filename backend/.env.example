# Copy to backend/.env and replace every placeholder. Do not commit backend/.env.
MQTT_HOSTNAME=HOSTNAME_OF_YOUR_MQTT_BROKER
MQTT_PORT=1883
MQTT_USERNAME=MQTT_USERNAME
MQTT_PASSWORD=MQTT_PASSWORD
MQTT_TOPIC=mumalab/room/door/status
MQTT_FEEDBACK_TOPIC=mumalab/room/door/feedback
ZUKO_LOCK_URL=http://USERNAME:PASSWORD@LOCK_HOST/open?who=USER
